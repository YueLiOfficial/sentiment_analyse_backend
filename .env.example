# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# ==================== 数据库配置 ====================
DB_DIALECT=mysql
DB_HOST=192.168.200.133
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=media_crawler_v1
DB_CHARSET=utf8mb4

# ==================== LLM API 配置 ====================

# Insight Agent — Kimi (https://platform.moonshot.cn/)
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=https://api.moonshot.cn/v1
INSIGHT_ENGINE_MODEL_NAME=kimi-k3
INSIGHT_ENGINE_MODEL_PROVIDER=openai

#INSIGHT_ENGINE_API_KEY=
#INSIGHT_ENGINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#INSIGHT_ENGINE_MODEL_NAME=qwen-plus
#INSIGHT_ENGINE_MODEL_PROVIDER=openai

#INSIGHT_ENGINE_API_KEY=
#INSIGHT_ENGINE_BASE_URL=https://api.openai-proxy.org/v1
#INSIGHT_ENGINE_MODEL_NAME=gemini-2.5-pro
#INSIGHT_ENGINE_MODEL_PROVIDER=openai


# Media Agent — Gemini
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=https://api.openai-proxy.org/v1
MEDIA_ENGINE_MODEL_NAME=gemini-2.5-pro
MEDIA_ENGINE_MODEL_PROVIDER=openai


# Host Agent — DeepSeek (https://www.deepseek.com/)
HOST_API_KEY=
HOST_BASE_URL=https://api.deepseek.com
HOST_MODEL_NAME=deepseek-chat
HOST_MODEL_PROVIDER=openai


# Report Engine 推荐 Gemini
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=https://api.deepseek.com
REPORT_ENGINE_MODEL_NAME=deepseek-chat
REPORT_ENGINE_MODEL_PROVIDER=openai




# ==================== 网络搜索配置 ====================
SEARCH_SWITCH=TavilyAPI
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

# Anspire API (可选)
ANSPIRE_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search


# ==================== Insight vector retrieval ====================
INSIGHT_VECTOR_ENABLED=true
MILVUS_URI=tcp://192.168.200.133:19530
MILVUS_DB_NAME=default
MILVUS_INSIGHT_COLLECTION=insight_evidence
INSIGHT_EMBEDDING_MODEL=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
INSIGHT_DENSE_DIM=1024
INSIGHT_VECTOR_TOP_K=40


# ========== 语义路由配置 ==========
INSIGHT_SEMANTIC_ROUTING_ENABLED=true
# 使用轻量中文模型做章节路由；本地离线就填本地模型目录路径
INSIGHT_SEMANTIC_ROUTING_MODEL=uer/sbert-zh-1.5-512

# ==================== Insight semantic clustering ====================
INSIGHT_CLUSTERING_ENABLED=false
INSIGHT_CLUSTER_MODEL=D:\ai_models\modelscope_cache\models\paraphrase-multilingual-MiniLM-L12-v2
INSIGHT_CLUSTER_MAX_RECORDS=300
INSIGHT_CLUSTER_MAX_CLUSTERS=10
INSIGHT_CLUSTER_MIN_CLUSTER_SIZE=5
